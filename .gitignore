# Credenciales y entorno. Nunca se suben.
.env
.venv/

# Python
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Datos que produce el programa. Se quedan en el Mac que ejecuta el monitor.
datos/

# Lo que genera "python taller.py entregar".

# Copie este archivo como .env (sin .example) y llene los valores.
# El archivo .env NUNCA se sube a GitHub ni entra en la entrega (está en .gitignore).

# Cuenta de Gmail que envía el correo diario
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cuenta_que_envia@gmail.com

# Contraseña de aplicación de 16 letras, NO la contraseña normal de Gmail.
# Se crea en https://myaccount.google.com/apppasswords después de activar la verificación en dos pasos.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Quién recibe el correo diario. Para varios, sepárelos con coma y sin espacios.
EMAIL_TO=correo_de_esteban@gmail.com,correo_del_companero@gmail.com

# Opcional. Póngalo en 1 si Carroya no responde al navegador invisible y hay que abrir una ventana visible.
NAVEGADOR_VISIBLE=0
